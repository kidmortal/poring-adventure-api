// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = "file:../../../dev.db"
}

model User {
  id                Int                @id @default(autoincrement())
  email             String             @unique
  name              String
  silver            Int                @default(20)
  admin             Boolean            @default(false)
  appearance        Appearance?
  guildMember       GuildMember?
  stats             Stats?
  class             Class?             @relation(fields: [classId], references: [id])
  classId           Int?
  Party             Party?             @relation(fields: [partyId], references: [id])
  partyId           Int?
  inventory         InventoryItem[]
  market            MarketListing[]
  mail              Mail[]
  learnedSkills     LearnedSkill[]
  buffs             UserBuff[]
  guildApplications GuildApplication[]
  purchases         UserPurchase[]
  professions       UserProfession[]
  serviceOffer      ServiceOffer?
  notifications     Notification[]
  discord           Discord?
  guildBossDamage   GuildBossDamage[]
  commissions       UserCommission[]
  dungeonEntries    DungeonEntry[]
  dungeonRuns       DungeonRunMember[]
}

model Discord {
  id        Int    @id @default(autoincrement())
  discordId String @unique
  name      String
  url       String
  user      User   @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  userEmail String @unique
}

model Stats {
  id         Int    @id @default(autoincrement())
  level      Int    @default(1)
  experience Int    @default(1)
  health     Int    @default(20)
  maxHealth  Int    @default(20)
  mana       Int    @default(20)
  maxMana    Int    @default(20)
  attack     Int    @default(1)
  str        Int    @default(1)
  agi        Int    @default(1)
  int        Int    @default(1)

  /// Flat mitigation, from class levels and gear. Fed through mitigate() in the
  /// battle engine, which caps the reduction so no gear tier can reach immunity.
  defense    Int    @default(0)

  /// Percent chance a hit or a heal lands for critDamage instead of its plain
  /// value. Everyone starts on 5 — a crit is something every character sees,
  /// not a mechanic a build has to opt into — and gear and buffs raise it.
  critRate   Int    @default(5)

  /// What a critical is worth, as a percent of the normal value. 200 is double.
  critDamage Int    @default(200)

  user       User   @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  userEmail  String @unique

  /// Daily resource: refilled to maxStamina the first time the user is seen on
  /// a new calendar day, tracked by staminaRefilledAt.
  stamina           Int      @default(50)
  maxStamina        Int      @default(50)
  staminaRefilledAt DateTime @default(now())
}

model InventoryItem {
  id        Int    @id @default(autoincrement())
  stack     Int
  user      User   @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  userEmail String
  item      Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    Int

  quality     Int @default(1)
  enhancement Int @default(0)

  equipped Boolean @default(false)
  locked   Boolean @default(false)

  marketListing MarketListing?

  @@unique([userEmail, itemId, quality, enhancement, equipped, locked])
}

model Appearance {
  id        Int    @id @default(autoincrement())
  head      String
  gender    String
  costume   String
  user      User   @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  userEmail String @unique
}

model Head {
  id     Int    @id @default(autoincrement())
  name   String
  gender String
  image  String

  @@unique([name, gender])
}

model MarketListing {
  id          Int           @id @default(autoincrement())
  price       Int
  stack       Int
  inventory   InventoryItem @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  inventoryId Int           @unique
  seller      User          @relation(fields: [sellerEmail], references: [email], onDelete: Cascade)
  sellerEmail String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  expiresAt   DateTime?
}

model Item {
  id       Int    @id @default(autoincrement())
  name     String
  category String
  image    String

  /// The character level needed to equip it. Ignored by anything that is not
  /// equipment — a consumable or a material is usable at any level.
  requiredLevel Int @default(1)

  attack    Int?
  str       Int?
  agi       Int?
  int       Int?
  health    Int?
  mana      Int?
  defense   Int?

  /// Both in percentage points, added on top of the character's own. The
  /// accessory slot is where they mostly live.
  critRate   Int?
  critDamage Int?

  /// A consumable that grants this buff when eaten. Cooking's whole niche: a
  /// meal is worth eating before a fight rather than during one.
  buff   Buff? @relation(fields: [buffId], references: [id])
  buffId Int?

  /// Whether the consumable may be used during a fight, at the cost of a turn.
  /// Alchemy's niche — food is deliberately left out of combat.
  battleUse Boolean @default(false)

  /// A meal that feeds the whole party rather than the one who ate it.
  partyWide Boolean @default(false)

  /// An action the consumable performs instead of restoring anything —
  /// currently only "escape". Alchemy's utility line, the things a Priest
  /// cannot do at any level.
  battleEffect String?

  inventory InventoryItem[]
  drop      Drop[]
  mail      Mail[]
  products  StoreProduct[]

  guildStoreProduct GuildStoreProduct?

  gatheringDrops    GatheringDrop[]
  craftedBy         Recipe[]           @relation("RecipeResult")
  recipeIngredients RecipeIngredient[] @relation("RecipeIngredient")
  commissions       Commission[]
  dungeonDrops      DungeonDrop[]
}

model Drop {
  id        Int     @id @default(autoincrement())
  chance    Int
  minAmount Int     @default(1)
  maxAmount Int     @default(1)
  monster   Monster @relation(fields: [monsterId], references: [id])
  monsterId Int
  item      Item    @relation(fields: [itemId], references: [id])
  itemId    Int

  @@unique([monsterId, itemId])
}

model Monster {
  id     Int     @id @default(autoincrement())
  name   String
  image  String
  level  Int     @default(1)
  boss   Boolean @default(false)
  attack Int     @default(1)
  health Int     @default(1)

  /// Speed, which decides where the monster sits in the turn order. Left at 0 it
  /// falls back to its level, so every monster seeded before this existed still
  /// acts roughly where its difficulty says it should.
  agi     Int    @default(0)
  defense Int    @default(0)

  silver Int     @default(1)
  exp    Int     @default(1)
  drops  Drop[]
  map    Map     @relation(fields: [mapId], references: [id])
  mapId  Int     @default(1)
}

model Map {
  id        Int         @id @default(autoincrement())
  name      String
  image     String
  monster   Monster[]
  guildTask GuildTask[]
}

model Party {
  id          Int    @id @default(autoincrement())
  leaderEmail String @unique
  members     User[]
}

/// The combat archetype picked at character creation: it owns the per-level
/// stat block and the skill list. This is what used to be called Profession —
/// that name now belongs to the crafting and gathering trades below.
model Class {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  icon        String  @default("❔")
  description String  @default("")
  costume     String  @default("none")
  attack      Int     @default(1)
  health      Int     @default(1)
  mana        Int     @default(1)
  str         Int     @default(1)
  agi         Int     @default(1)
  int         Int     @default(1)
  defense     Int     @default(0)
  skills      Skill[]
  users       User[]
}

/// A crafting or gathering trade. Professions have nothing to do with combat:
/// they are learned on top of the class, level on their own, and every action
/// they offer is paid for with stamina.
model Profession {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  icon        String           @default("❔")
  description String           @default("")
  /// "gathering" — its nodes produce items; "crafting" — its recipes consume them.
  kind        String           @default("gathering")
  /// Whether this profession may enhance items for other players.
  canEnhance  Boolean          @default(false)
  nodes       GatheringNode[]
  recipes     Recipe[]
  learnedBy   UserProfession[]
  offers      ServiceOffer[]
  commissions Commission[]
}

/// A crafter selling their stamina: other players pay silver per stamina point
/// to have them craft or enhance on their behalf. One offer per crafter, since
/// a player only practices one profession at a time.
model ServiceOffer {
  id              Int        @id @default(autoincrement())
  crafter         User       @relation(fields: [crafterEmail], references: [email], onDelete: Cascade)
  crafterEmail    String     @unique
  profession      Profession @relation(fields: [professionId], references: [id], onDelete: Cascade)
  professionId    Int
  /// Silver charged per stamina point the job costs the crafter.
  pricePerStamina Int        @default(50)
  crafting        Boolean    @default(true)
  /// Only professions with canEnhance may turn this on.
  enhancing       Boolean    @default(false)
  createdAt       DateTime   @default(now())
}

/// One profession a user has learned. Each carries its own progression, so a
/// player levels mining and cooking independently.
model UserProfession {
  id           Int        @id @default(autoincrement())
  user         User       @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  userEmail    String
  profession   Profession @relation(fields: [professionId], references: [id], onDelete: Cascade)
  professionId Int
  level        Int        @default(1)
  experience   Int        @default(0)
  learnedAt    DateTime   @default(now())

  @@unique([userEmail, professionId])
}

/// A gatherable spot. Paying its stamina cost rolls every drop once.
model GatheringNode {
  id            Int             @id @default(autoincrement())
  name          String          @unique
  image         String          @default("")
  profession    Profession      @relation(fields: [professionId], references: [id], onDelete: Cascade)
  professionId  Int
  requiredLevel Int             @default(1)
  staminaCost   Int             @default(5)
  experience    Int             @default(10)
  drops         GatheringDrop[]
}

model GatheringDrop {
  id        Int           @id @default(autoincrement())
  chance    Int
  minAmount Int           @default(1)
  maxAmount Int           @default(1)
  node      GatheringNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  nodeId    Int
  item      Item          @relation(fields: [itemId], references: [id])
  itemId    Int

  @@unique([nodeId, itemId])
}

/// Ingredients plus stamina in, one item out. Crafting never fails: the
/// requiredLevel is what gates a recipe, not a roll.
model Recipe {
  id            Int                @id @default(autoincrement())
  name          String             @unique
  profession    Profession         @relation(fields: [professionId], references: [id], onDelete: Cascade)
  professionId  Int
  requiredLevel Int                @default(1)
  staminaCost   Int                @default(5)
  experience    Int                @default(10)
  item          Item               @relation("RecipeResult", fields: [itemId], references: [id])
  itemId        Int
  amount        Int                @default(1)
  ingredients   RecipeIngredient[]
}

model RecipeIngredient {
  id       Int    @id @default(autoincrement())
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId Int
  item     Item   @relation("RecipeIngredient", fields: [itemId], references: [id])
  itemId   Int
  amount   Int    @default(1)

  @@unique([recipeId, itemId])
}

model Skill {
  id            Int            @id @default(autoincrement())
  requiredLevel Int            @default(1)
  manaCost      Int            @default(1)
  cooldown      Int            @default(1)
  category      String         @default("target_enemy")
  effect        String?
  name          String
  image         String
  description   String         @default("Skill Description")
  attribute     String
  multiplier    Int            @default(1)

  /// How much threat the skill generates per point of damage. This is what lets
  /// a tank hold aggro without out-damaging the party.
  threatModifier Float @default(1)

  /// Whether the skill hits every enemy standing, or heals the whole party,
  /// instead of the single target it was pointed at. Damage and healing are
  /// scaled down when it does, so a pull of one is never the better target.
  areaOfEffect Boolean @default(false)

  class         Class          @relation(fields: [classId], references: [id])
  classId       Int
  learnedSkill  LearnedSkill[]
  buff          Buff?          @relation(fields: [buffId], references: [id])
  buffId        Int?
  /// Set when landing the skill leaves something on the enemy.
  debuff        Debuff?        @relation(fields: [debuffId], references: [id])
  debuffId      Int?
}

/// Something a skill leaves on a monster: the mirror of Buff, which only ever
/// sits on a player. It lives on the monster for the length of one fight and is
/// never persisted, so there is no MonsterDebuff row to clean up — the battle
/// instance carries it and the battle payload ships it, icon included, for the
/// client to draw beside the health bar.
model Debuff {
  id       Int    @id @default(autoincrement())
  name     String @unique
  /// Which branch of `debuffs.ts` runs. `none` is inert but still displayed.
  effect   String @default("none")
  /// Turns of the afflicted monster's own turns it survives.
  duration Int    @default(2)
  image    String
  /// The magnitude the effect reads, as a percentage. What it is a percentage
  /// of is the effect's business — armour shredded, damage lost, health burned.
  potency  Int    @default(0)
  /// How many copies may sit on one monster at once.
  maxStack Int    @default(1)

  skill Skill[]
}

model LearnedSkill {
  id           Int     @id @default(autoincrement())
  user         User    @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  userEmail    String
  skill        Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId      Int
  masteryLevel Int     @default(1)
  equipped     Boolean @default(false)

  @@unique([userEmail, skillId])
}

model Mail {
  id         Int      @id @default(autoincrement())
  sender     String
  content    String
  claimed    Boolean  @default(false)
  silver     Int?     @default(0)
  item       Item?    @relation(fields: [itemId], references: [id])
  itemId     Int?
  itemStack  Int?
  visualized Boolean
  user       User     @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  userEmail  String
  createdAt  DateTime @default(now())
}

/// A record of something that happened to a player while they were away: a
/// service of theirs being hired, and what it earned them. Purely informational
/// — the silver and experience are already paid when the row is written.
model Notification {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  userEmail  String
  /// What happened, so the client can pick an icon: hired_craft, hired_enhance.
  type       String   @default("info")
  title      String
  message    String
  silver     Int      @default(0)
  experience Int      @default(0)
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model UserBuff {
  id        Int    @id @default(autoincrement())
  buff      Buff   @relation(fields: [buffId], references: [id])
  buffId    Int
  user      User   @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  userEmail String
  duration  Int

  @@unique([userEmail, buffId])
}

model Buff {
  id       Int        @id @default(autoincrement())
  name     String     @unique
  effect   String     @default("none")
  duration Int
  image    String
  pose     String     @default("default")
  persist  Boolean    @default(false)
  maxStack Int        @default(1)

  /// Percentages the "well_fed" effect reads. Kept as columns rather than
  /// encoded in the effect string so a new meal is a seed row, not new code.
  attackBonus Int @default(0)
  healthBonus Int @default(0)

  /// Percentage points added to the holder's crit rate and crit damage while
  /// the buff is up. Read at the moment a hit or a heal is rolled, so nothing
  /// has to be unwound when the buff falls off.
  critRateBonus   Int @default(0)
  critDamageBonus Int @default(0)

  userBuff UserBuff[]
  skill    Skill[]
  items    Item[]
}

/// A standing NPC contract: hand over N of an item, get paid for it. This is
/// the price floor under every crafted good — a crafter always has one buyer,
/// even when no player wants what they make. The offered set rotates per player
/// per day, so demand regenerates instead of saturating permanently.
model Commission {
  id            Int              @id @default(autoincrement())
  item          Item             @relation(fields: [itemId], references: [id])
  itemId        Int
  amount        Int              @default(1)
  silver        Int
  /// Profession experience the delivery is worth to the crafter.
  experience    Int              @default(0)
  requiredLevel Int              @default(1)
  profession    Profession       @relation(fields: [professionId], references: [id], onDelete: Cascade)
  professionId  Int
  takenBy       UserCommission[]

  /// The profession belongs in the key: a cook and a fisherman can both be
  /// asked for six raw fish, and those are two different contracts.
  @@unique([professionId, itemId, amount])
}

/// One filled contract. Which contracts a player is *offered* is derived from
/// their email and the day rather than stored, so the board is stable without a
/// write; a row here exists only once the goods have been handed over. The day
/// in the key is what caps the board — a contract can be filled once a day, and
/// tomorrow's board is a different draw.
model UserCommission {
  id           Int        @id @default(autoincrement())
  user         User       @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  userEmail    String
  commission   Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  commissionId Int
  deliveredAt  DateTime   @default(now())
  /// UTC calendar day the contract belonged to, as "YYYY-M-D".
  offeredOn    String

  @@unique([userEmail, commissionId, offeredOn])
}

model Guild {
  id                Int                @id @default(autoincrement())
  name              String             @unique
  leaderEmail       String             @unique
  imageUrl          String             @default("https://kidmortal.sirv.com/misc/guild_image.png")
  level             Int                @default(1)
  experience        Int                @default(0)
  taskPoints        Int                @default(0)
  publicMessage     String             @default("Lets have fun")
  internalMessage   String             @default("Lets have fun")
  members           GuildMember[]
  guildApplications GuildApplication[]
  currentGuildTask  CurrentGuildTask?
  currentGuildBoss  CurrentGuildBoss?
  blessing          GuildBlessing?
}

model GuildBlessing {
  id      Int   @id @default(autoincrement())
  guild   Guild @relation(fields: [guildId], references: [id])
  guildId Int   @unique
  health  Int   @default(5)
  mana    Int   @default(5)
  str     Int   @default(1)
  int     Int   @default(1)
  agi     Int   @default(1)
}

model CurrentGuildTask {
  id             Int       @id @default(autoincrement())
  task           GuildTask @relation(fields: [guildTaskId], references: [id])
  guildTaskId    Int
  remainingKills Int
  guild          Guild     @relation(fields: [guildId], references: [id])
  guildId        Int       @unique
}

model GuildTask {
  id     Int    @id @default(autoincrement())
  name   String @unique
  /// The sprite the offer is illustrated with. A map's own image is its boss,
  /// so a task to clear out porings was advertising a King Poring; this lets a
  /// task show what it actually asks you to kill. Falls back to the map image.
  image  String @default("")
  target Map    @relation(fields: [mapId], references: [id])
  mapId  Int

  killCount        Int                @default(10)
  taskPoints       Int                @default(10)
  currentGuildTask CurrentGuildTask[]
}

model GuildMember {
  id              Int    @id @default(autoincrement())
  role            String @default("member")
  permissionLevel Int    @default(0)
  contribution    Int    @default(0)
  guildTokens     Int    @default(0)
  user            User   @relation(fields: [userEmail], references: [email])
  userEmail       String @unique
  guild           Guild? @relation(fields: [guildId], references: [id])
  guildId         Int?

  /// One boss entry per UTC day, spent on the fight that starts. Null means the
  /// member has never fought one.
  bossEntryUsedAt DateTime?

  @@unique([userEmail, guildId])
}

/// A boss a guild can summon. The numbers here are the easy-difficulty ones —
/// the chosen difficulty multiplies them, see guildBoss.rules.
model GuildBoss {
  id                 Int                @id @default(autoincrement())
  name               String             @unique
  image              String
  level              Int                @default(1)
  health             Int                @default(20000)
  attack             Int                @default(20)
  /// Handed out on the kill: shards to the guild, tokens split by damage dealt.
  taskPoints         Int                @default(100)
  tokens             Int                @default(100)
  /// Per fight, like any other monster.
  silver             Int                @default(100)
  exp                Int                @default(100)
  requiredGuildLevel Int                @default(1)
  currentGuildBoss   CurrentGuildBoss[]
}

/// The boss a guild currently has standing. Its health pool persists between
/// fights: the guild wears it down over days, one entry per member per day.
model CurrentGuildBoss {
  id          Int               @id @default(autoincrement())
  guild       Guild             @relation(fields: [guildId], references: [id])
  guildId     Int               @unique
  boss        GuildBoss         @relation(fields: [guildBossId], references: [id])
  guildBossId Int
  difficulty  String            @default("easy")
  maxHealth   Int
  health      Int
  attack      Int
  summonedAt  DateTime          @default(now())
  damage      GuildBossDamage[]
}

/// What each member has banked against the standing boss. It decides their cut
/// of the token pool when the boss finally dies, then goes away with it.
model GuildBossDamage {
  id                 Int              @id @default(autoincrement())
  currentGuildBoss   CurrentGuildBoss @relation(fields: [currentGuildBossId], references: [id], onDelete: Cascade)
  currentGuildBossId Int
  user               User             @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  userEmail          String
  /// The score, which is what the token payout is split by. A party banks its
  /// damage evenly, so this is not what the member personally hit for.
  damage             Int              @default(0)
  /// What they personally hit for, kept so the ranking can show who carried a
  /// fight even though the score is shared.
  dealtDamage        Int              @default(0)
  /// Identifies the party this member last fought the boss with, so the ranking
  /// can show them linked. Null for a member who fought alone.
  partyKey           String?
  /// Who led that party, so the ranking can head the group with them.
  partyLeaderEmail   String?

  @@unique([currentGuildBossId, userEmail])
}

/// Sold for guild tokens, which members earn by contributing to guild tasks and
/// by fighting the guild boss.
model GuildStoreProduct {
  id      Int     @id @default(autoincrement())
  item    Item    @relation(fields: [itemId], references: [id])
  itemId  Int     @unique
  price   Int
  stack   Int     @default(1)
  enabled Boolean @default(true)
}

model GuildApplication {
  id        Int    @id @default(autoincrement())
  user      User   @relation(fields: [userEmail], references: [email])
  userEmail String
  guild     Guild  @relation(fields: [guildId], references: [id])
  guildId   Int
}

/// A gauntlet of three bosses fought back to back on one entry a day.
///
/// A map is a place you can go back to all afternoon; a dungeon is a single
/// attempt. That is what lets its monsters be tuned well above anything on a
/// map — the party only gets one run at them, and what they walk out with is
/// budgeted against a day rather than against an hour of farming.
model Dungeon {
  id          Int    @id @default(autoincrement())
  name        String @unique
  image       String
  description String @default("")

  /// Advisory only, and shown on the card. Nothing stops an under-levelled
  /// party from walking in — the bosses will do that on their own.
  recommendedLevel Int @default(1)

  /// Where it sits in the list, so the client never has to sort by level and
  /// guess at ties.
  sortOrder Int @default(0)

  monsters DungeonMonster[]
  entries  DungeonEntry[]
  runs     DungeonRun[]
}

/// A dungeon boss. Deliberately its own table rather than a Monster: these are
/// stronger than anything with a mapId, they are never rolled into a random
/// pull, and they carry a stage that fixes the order they are fought in.
model DungeonMonster {
  id        Int     @id @default(autoincrement())
  dungeon   Dungeon @relation(fields: [dungeonId], references: [id], onDelete: Cascade)
  dungeonId Int

  /// 1, 2, 3 — the order the party meets them in. The last one is the dungeon's
  /// real fight; the two before it are the toll paid to reach it with health
  /// left, since nothing is topped up between them beyond the camp restore.
  stage Int

  name   String
  image  String
  level  Int    @default(1)
  attack Int    @default(1)
  health Int    @default(1)
  agi    Int    @default(0)

  defense Int @default(0)

  /// Paid out on the kill like any other monster, so the reward per stage is
  /// simply the numbers here: small, small, large.
  silver Int @default(1)
  exp    Int @default(1)

  drops DungeonDrop[]

  @@unique([dungeonId, stage])
}

/// A dungeon boss's loot table. The mirror of Drop, which belongs to Monster.
model DungeonDrop {
  id        Int            @id @default(autoincrement())
  monster   DungeonMonster @relation(fields: [monsterId], references: [id], onDelete: Cascade)
  monsterId Int
  item      Item           @relation(fields: [itemId], references: [id])
  itemId    Int
  chance    Int
  minAmount Int            @default(1)
  maxAmount Int            @default(1)

  @@unique([monsterId, itemId])
}

/// One row per player per dungeon, holding when they last walked in. Entries
/// come back on the UTC day boundary, the same rule stamina and the guild boss
/// entry use, so one row is enough — there is no history to keep.
model DungeonEntry {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  userEmail String
  dungeon   Dungeon  @relation(fields: [dungeonId], references: [id], onDelete: Cascade)
  dungeonId Int
  usedAt    DateTime @default(now())

  @@unique([userEmail, dungeonId])
}

/// One party's attempt at a dungeon. It outlives the individual boss fights,
/// which is the whole reason it is a row: the party can be knocked offline
/// between the second and third boss and pick the run back up where it stopped.
model DungeonRun {
  id        Int     @id @default(autoincrement())
  dungeon   Dungeon @relation(fields: [dungeonId], references: [id])
  dungeonId Int

  /// Whoever spent the entries. A solo run is its own leader.
  leaderEmail String

  /// Bosses already down. The next fight is `stage + 1`, and the run is cleared
  /// when this reaches the dungeon's boss count.
  stage Int @default(0)

  /// active, cleared or failed. A wipe or a retreat fails it, and the entry is
  /// spent either way — that is the cost of the attempt.
  status String @default("active")

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  members DungeonRunMember[]

  @@index([status])
}

/// Who walked in. Kept apart from the party, which can be rearranged mid-run:
/// the run is fought by the people who paid for it.
model DungeonRunMember {
  id           Int        @id @default(autoincrement())
  run          DungeonRun @relation(fields: [dungeonRunId], references: [id], onDelete: Cascade)
  dungeonRunId Int
  user         User       @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  userEmail    String

  @@unique([dungeonRunId, userEmail])
  @@index([userEmail])
}

model UserPurchase {
  id             Int          @id @default(autoincrement())
  transactionId  String       @unique
  appUserId      String
  received       Boolean      @default(false)
  refunded       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  product        StoreProduct @relation(fields: [storeProductId], references: [id])
  storeProductId Int
  user           User         @relation(fields: [userEmail], references: [email])
  userEmail      String
}

model StoreProduct {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  displayName   String         @unique
  // Rewards handed out when the purchase is claimed
  silver        Int            @default(0)
  item          Item?          @relation(fields: [itemId], references: [id])
  itemId        Int?
  itemStack     Int            @default(1)
  userPurchases UserPurchase[]
}
